{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vocalstack/record",
	"version": "0.1.0",
	"title": "VocalStack Record",
	"category": "media",
	"icon": "microphone",
	"description": "A record button: people record from their microphone, a browser tab, or your live stream, and see the transcript as they speak.",
	"keywords": [
		"record",
		"microphone",
		"live",
		"transcribe",
		"dictation"
	],
	"textdomain": "vocalstack",
	"attributes": {
		"sources": {
			"type": "string",
			"default": "mic"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"language": {
			"type": "string",
			"default": ""
		},
		"speakers": {
			"type": "string",
			"default": ""
		},
		"maxRecordMinutes": {
			"type": "integer",
			"default": 0
		},
		"access": {
			"type": "string",
			"default": ""
		},
		"roles": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "minimal",
			"label": "Minimal"
		},
		{
			"name": "card",
			"label": "Card"
		}
	],
	"editorScript": "file:./index.js",
	"style": [
		"vocalstack-widget-record"
	]
}
