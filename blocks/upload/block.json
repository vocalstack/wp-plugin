{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vocalstack/upload",
	"version": "0.1.0",
	"title": "VocalStack Upload",
	"category": "media",
	"icon": "upload",
	"description": "An upload area: files go into the Media Library and are transcribed, then the transcript appears.",
	"keywords": [
		"upload",
		"file",
		"transcribe",
		"audio",
		"video"
	],
	"textdomain": "vocalstack",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"accept": {
			"type": "string",
			"default": "audio,video"
		},
		"language": {
			"type": "string",
			"default": ""
		},
		"transcript": {
			"type": "boolean",
			"default": true
		},
		"maxUploadMb": {
			"type": "integer",
			"default": 0
		},
		"access": {
			"type": "string",
			"default": ""
		},
		"roles": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "minimal",
			"label": "Minimal"
		},
		{
			"name": "card",
			"label": "Card"
		}
	],
	"editorScript": "file:./index.js",
	"style": [
		"vocalstack-widget-upload"
	]
}
