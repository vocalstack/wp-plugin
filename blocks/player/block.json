{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vocalstack/player",
	"version": "0.1.0",
	"title": "VocalStack Player",
	"category": "media",
	"icon": "controls-play",
	"description": "Play audio or video with its transcript: a Media Library file, a VocalStack recording, or a live broadcast.",
	"keywords": [
		"audio",
		"video",
		"transcript",
		"broadcast",
		"live",
		"podcast"
	],
	"textdomain": "vocalstack",
	"attributes": {
		"source": {
			"type": "string",
			"default": "media"
		},
		"id": {
			"type": "string",
			"default": ""
		},
		"transcript": {
			"type": "boolean",
			"default": true
		},
		"timestamps": {
			"type": "boolean",
			"default": true
		},
		"speakers": {
			"type": "boolean",
			"default": true
		},
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "minimal",
			"label": "Minimal"
		},
		{
			"name": "card",
			"label": "Card"
		}
	],
	"editorScript": "file:./index.js",
	"style": [
		"vocalstack-widget-player"
	]
}
